# Builds Flo from this checkout: `cd packaging && makepkg -si`.
pkgname=flo
pkgver=0.1.0
pkgrel=1
pkgdesc="A lightweight file manager for Omarchy, following Folio's keys and standards"
arch=('x86_64' 'aarch64')
url="https://github.com/avillagran/flo"
license=('MIT')
# FLTK links statically (libfltk.a), so fltk is only needed to build. These
# are the libraries the flo binary and its static FLTK load at runtime.
depends=(
  'cairo'
  'dbus'
  'fontconfig'
  'glib2'
  'hicolor-icon-theme'
  'libarchive'
  'libdecor'
  'libjpeg-turbo'
  'libpng'
  'libx11'
  'libxcursor'
  'libxext'
  'libxfixes'
  'libxft'
  'libxinerama'
  'libxkbcommon'
  'libxrender'
  'pango'
  'wayland'
  'zlib'
)
optdepends=(
  'ffmpegthumbnailer: video thumbnails'
  'papers: PDF thumbnails'
  'gvfs: browsing tailnet machines over SFTP, drives'
  'tailscale: listing tailnet machines'
  'dropbox-cli: Dropbox sync status'
  'xdg-utils: opening files with their default apps'
)
makedepends=('cmake' 'gcc' 'fltk' 'git')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  git submodule update --init
  cmake -S . -B build/pkg -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DFLO_BUILD_TESTS=OFF
  cmake --build build/pkg
}

package() {
  cd "$startdir/.."
  DESTDIR="$pkgdir" cmake --install build/pkg
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/flo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/flo.svg"
  install -Dm644 packaging/flo.desktop "$pkgdir/usr/share/applications/flo.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
